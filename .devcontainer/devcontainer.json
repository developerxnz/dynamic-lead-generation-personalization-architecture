{
  "name": "Lead Gen Platform",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {}
  },
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteEnv": {
    "OLLAMA_BASE_URL": "http://ollama:11434",
    "OLLAMA_MODEL": "llama3.1:8b",
    "COSMOS_ENDPOINT": "http://cosmosdb:8081",
    "COSMOS_HEALTHCHECK_URL": "http://cosmosdb:8080/ready",
    "COSMOS_KEY": "C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==",
    "COSMOS_DATABASE": "leadgen-local",
    "COSMOS_PROFILES_CONTAINER": "profiles",
    "COSMOS_JOURNEYS_CONTAINER": "journeys",
    "COSMOS_EVENTS_CONTAINER": "events",
    "COSMOS_DECISION_TRACES_CONTAINER": "decision-traces"
  },
  "forwardPorts": [11434, 1234, 8080, 8081],
  "postCreateCommand": "pip install -r requirements.txt && ./scripts/wait-for-cosmos.sh && ./scripts/setup-ollama.sh",
  "postStartCommand": "./scripts/wait-for-ollama.sh && ./scripts/wait-for-cosmos.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.pylance",
        "bierner.markdown-preview-github-styles",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
